# FinAlly environment configuration.
# Copy this file to `.env` and fill in your values:
#   cp .env.example .env        (macOS/Linux)
#   Copy-Item .env.example .env (Windows PowerShell)
#
# The backend reads these from the project root, either mounted into the
# container or passed via `docker run --env-file .env` / compose `env_file`.

# Required: OpenRouter API key for LLM chat functionality.
# Without it (and with LLM_MOCK=false) the chat assistant cannot reach a real LLM.
OPENROUTER_API_KEY=

# Optional: Massive (Polygon.io) API key for real market data.
# If set and non-empty  -> backend uses the Massive REST API.
# If absent or empty     -> backend uses the built-in market simulator (recommended).
MASSIVE_API_KEY=

# Optional: set to "true" for deterministic mock LLM responses (testing / no API key).
# If "true"  -> backend returns canned, reproducible chat responses (used by E2E tests).
# If "false" -> backend calls OpenRouter using OPENROUTER_API_KEY.
LLM_MOCK=false
